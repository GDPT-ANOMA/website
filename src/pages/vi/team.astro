---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { copy, site, t } from "../../i18n/site";

const locale = "vi" as const;
const lang = "vi";
const staff = (await getCollection("staff")).sort((a, b) => a.data.order - b.data.order);
---

<Layout title={`Huynh trưởng — ${site.nameShort}`} locale={locale}>
  <main class="page-wrap py-[var(--space-section)]">
    <h1 class="font-extrabold m-0 mb-3" style="font-size: var(--text-3xl);" lang={lang}>
      {t(copy.teamPage.title, locale)}
    </h1>
    <p class="m-0 mb-10 max-w-2xl" lang={lang}>{t(copy.teamPage.lead, locale)}</p>

    {
      staff.length === 0 ? (
        <p lang={lang}>{t(copy.teamPage.empty, locale)}</p>
      ) : (
        <ul class="list-none m-0 p-0 divide-y divide-[color:var(--rule)] max-w-2xl">
          {staff.map((person) => (
            <li class="py-5">
              <p class="font-bold text-lg m-0">{person.data.name}</p>
              <p class="text-sm text-la font-semibold m-0 mt-1" lang={lang}>
                {t(person.data.roleLabel, locale)}
              </p>
              {person.data.focus && (
                <p class="m-0 mt-2" lang={lang}>{t(person.data.focus, locale)}</p>
              )}
              {person.data.contact && (
                <p class="m-0 mt-2 text-sm">
                  <a class="text-lam-deep underline underline-offset-2" href={`mailto:${person.data.contact}`}>
                    {person.data.contact}
                  </a>
                </p>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>
