---
import { getCollection } from "astro:content";
import Home from "../../components/home/Home.astro";
import Layout from "../../layouts/Layout.astro";
import { upcomingEvents } from "../../lib/events";
import { site } from "../../i18n/site";

const locale = "vi" as const;

const [schedule, nganh, events, announcements] = await Promise.all([
  getCollection("schedule"),
  getCollection("nganh"),
  getCollection("events"),
  getCollection("announcements"),
]);

schedule.sort((a, b) => a.data.order - b.data.order);
nganh.sort((a, b) => a.data.order - b.data.order);
announcements.sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
---

<Layout
  title={`${site.nameShort} | Quỹ Vạn Hạnh`}
  description="GĐPT Anôma là đơn vị Gia Đình Phật Tử tại Quỹ Vạn Hạnh ở Gardena. Các em lớn lên với Bi–Trí–Dũng qua tập hợp, Phật pháp, và giờ ngành mỗi Chủ Nhật."
  locale={locale}
>
  <Home
    locale={locale}
    schedule={schedule}
    nganh={nganh}
    events={upcomingEvents(events)}
    announcements={announcements}
  />
</Layout>
