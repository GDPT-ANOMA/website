---
import { getCollection } from "astro:content";
import Home from "../../components/home/Home.astro";
import Layout from "../../layouts/Layout.astro";
import { site } from "../../i18n/site";

const locale = "vi" as const;

const [schedule, nganh, events, announcements] = await Promise.all([
  getCollection("schedule"),
  getCollection("nganh"),
  getCollection("events"),
  getCollection("announcements"),
]);

const startOfToday = new Date();
startOfToday.setUTCHours(0, 0, 0, 0);

schedule.sort((a, b) => a.data.order - b.data.order);
nganh.sort((a, b) => a.data.order - b.data.order);
events.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const upcomingEvents = events.filter((event) => {
  const end = event.data.endDate ?? event.data.date;
  return end.valueOf() >= startOfToday.valueOf();
});
announcements.sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
---

<Layout
  title={`${site.nameShort} — Chủ Nhật 9:00`}
  description="GĐPT Anôma — Gia Đình Phật Tử. Chủ Nhật 9:00 sáng–2:00 chiều tại 14867 Spinning Ave., Gardena, CA 90249."
  locale={locale}
>
  <Home
    locale={locale}
    schedule={schedule}
    nganh={nganh}
    events={upcomingEvents}
    announcements={announcements}
  />
</Layout>
