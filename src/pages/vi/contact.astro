---
import Layout from "../../layouts/Layout.astro";
import { copy, site, t } from "../../i18n/site";

const locale = "vi" as const;
const lang = "vi";
---

<Layout title={`Liên hệ — ${site.nameShort}`} locale={locale}>
  <main class="page-wrap py-[var(--space-section)] max-w-2xl">
    <h1 class="font-extrabold m-0 mb-3" style="font-size: var(--text-3xl);" lang={lang}>
      {t(copy.contactPage.title, locale)}
    </h1>
    <p class="m-0 mb-4" lang={lang}>{t(copy.contactPage.lead, locale)}</p>
    <p class="m-0 mb-8 text-sm text-lam-deep">
      <a class="underline underline-offset-2" href={`mailto:${site.email}`}>{site.email}</a>
      <span class="mx-2">·</span>
      <span lang={lang}>{t(site.address, locale)}</span>
    </p>
    <p class="text-sm text-lam m-0 mb-8" lang={lang}>{t(site.textHint, locale)}</p>

    <form id="contact-form" class="grid gap-4" novalidate>
      <label class="grid gap-1 text-sm font-semibold text-lam-deep">
        {t(copy.contactPage.formName, locale)}
        <input
          name="name"
          required
          autocomplete="name"
          class="min-h-11 border border-rule bg-sen px-3 font-normal text-ink"
        />
      </label>
      <label class="grid gap-1 text-sm font-semibold text-lam-deep">
        {t(copy.contactPage.formEmail, locale)}
        <input
          name="email"
          type="email"
          required
          autocomplete="email"
          class="min-h-11 border border-rule bg-sen px-3 font-normal text-ink"
        />
      </label>
      <label class="grid gap-1 text-sm font-semibold text-lam-deep">
        {t(copy.contactPage.formSubject, locale)}
        <input
          name="subject"
          required
          class="min-h-11 border border-rule bg-sen px-3 font-normal text-ink"
        />
      </label>
      <label class="grid gap-1 text-sm font-semibold text-lam-deep">
        {t(copy.contactPage.formMessage, locale)}
        <textarea
          name="message"
          required
          rows="5"
          class="border border-rule bg-sen px-3 py-2 font-normal text-ink"
        ></textarea>
      </label>
      <button type="submit" class="btn btn-la justify-self-start" id="contact-submit">
        {t(copy.contactPage.formSubmit, locale)}
      </button>
      <p id="contact-status" class="text-sm m-0" role="status" aria-live="polite" hidden></p>
    </form>
  </main>
</Layout>

<script is:inline data-astro-rerun define:vars={{
    okMsg: t(copy.contactPage.formOk, locale),
    errMsg: t(copy.contactPage.formErr, locale),
    sendingMsg: t(copy.contactPage.formSending, locale),
    submitLabel: t(copy.contactPage.formSubmit, locale),
  }}
>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("contact-status");
  const submit = document.getElementById("contact-submit");
  if (!form || !status || !submit) {
    // Form not on this page (or already torn down during a transition).
  } else if (!form.dataset.bound) {
    form.dataset.bound = "1";
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      submit.setAttribute("disabled", "true");
      submit.textContent = sendingMsg;
      status.hidden = true;

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            firstName: String(data.get("name") || "").trim(),
            lastName: "",
            email: String(data.get("email") || "").trim(),
            subject: String(data.get("subject") || "").trim(),
            message: String(data.get("message") || "").trim(),
          }),
        });
        status.hidden = false;
        status.textContent = res.ok ? okMsg : errMsg;
        status.className = res.ok ? "text-sm m-0 text-la" : "text-sm m-0 text-lam-deep";
        if (res.ok) form.reset();
      } catch {
        status.hidden = false;
        status.textContent = errMsg;
        status.className = "text-sm m-0 text-lam-deep";
      } finally {
        submit.removeAttribute("disabled");
        submit.textContent = submitLabel;
      }
    });
  }
</script>
