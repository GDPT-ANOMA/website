---
import { getCollection } from "astro:content";
import ScheduleSplit from "../../components/ScheduleSplit.astro";
import Layout from "../../layouts/Layout.astro";
import { copy, site, t } from "../../i18n/site";
import { fetchGoogleCalendarEvents } from "../../lib/googleCalendar";

const locale = "vi" as const;
const lang = "vi";

const schedule = (await getCollection("schedule")).sort(
  (a, b) => a.data.order - b.data.order,
);
const events = (await getCollection("events")).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const calendar = await fetchGoogleCalendarEvents({ maxResults: 100 });
---

<Layout title={`Lịch — ${site.nameShort}`} locale={locale}>
  <main class="page-wrap py-[var(--space-section)]">
    <h1 class="font-extrabold m-0 mb-2" style="font-size: var(--text-3xl);" lang={lang}>
      {t(copy.schedulePage.title, locale)}
    </h1>
    <p class="m-0 mb-8 text-ink/85" lang={lang}>{t(copy.schedulePage.lead, locale)}</p>

    <ScheduleSplit locale={locale} schedule={schedule} events={events} />

    {
      calendar.length > 0 && (
        <section class="mt-12">
          <h2 class="text-xl font-bold m-0 mb-3" lang={lang}>{t(copy.schedulePage.calendarTitle, locale)}</h2>
          <ul class="list-none m-0 p-0 divide-y divide-[color:var(--rule)]">
            {calendar.slice(0, 12).map((ev) => {
              const start = ev.start.dateTime || ev.start.date || "";
              return (
                <li class="py-3">
                  <p class="text-sm text-la font-semibold m-0">{start}</p>
                  <p class="font-bold m-0 mt-1">{ev.summary}</p>
                  {ev.location && <p class="text-sm text-lam m-0 mt-1">{ev.location}</p>}
                </li>
              );
            })}
          </ul>
        </section>
      )
    }
  </main>
</Layout>
