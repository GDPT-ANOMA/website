---
import Layout from "../../layouts/Layout.astro";
import { copy, site, t } from "../../i18n/site";

const locale = "vi" as const;
const lang = "vi";
---

<Layout title={`Giới thiệu — ${site.nameShort}`} locale={locale}>
  <main class="page-wrap py-[var(--space-section)]">
    <h1 class="text-3xl font-extrabold m-0 mb-4" style="font-size: var(--text-3xl);" lang={lang}>
      {t(copy.about.title, locale)}
    </h1>
    <p class="text-lg m-0 mb-10" lang={lang}>{t(copy.about.lead, locale)}</p>

    <h2 class="text-xl font-bold m-0 mb-4" lang="vi">{t(copy.about.pillarsTitle, locale)}</h2>
    <ul class="list-none m-0 p-0 space-y-4 max-w-xl">
      <li class="border-l-2 border-la pl-4">
        <p class="font-bold m-0" lang="vi">Bi</p>
        <p class="m-0 mt-1" lang={lang}>{t(copy.about.bi, locale)}</p>
      </li>
      <li class="border-l-2 border-la pl-4">
        <p class="font-bold m-0" lang="vi">Trí</p>
        <p class="m-0 mt-1" lang={lang}>{t(copy.about.tri, locale)}</p>
      </li>
      <li class="border-l-2 border-la pl-4">
        <p class="font-bold m-0" lang="vi">Dũng</p>
        <p class="m-0 mt-1" lang={lang}>{t(copy.about.dung, locale)}</p>
      </li>
    </ul>

    <p class="mt-10 mb-0 max-w-xl" lang={lang}>{t(copy.about.anthem, locale)}</p>
  </main>
</Layout>
