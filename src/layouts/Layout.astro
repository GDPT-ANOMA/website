---
import "../styles/global.css";
import {
  copy,
  localeFromPath,
  localePath,
  site,
  t,
  type Locale,
} from "../i18n/site";

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
}

const pathname = Astro.url.pathname;
const locale = Astro.props.locale ?? localeFromPath(pathname);
const {
  title,
  description = `${site.nameShort} — ${t(site.sunday, locale)}`,
} = Astro.props;

const nav = [
  { href: "/about", label: copy.nav.about },
  { href: "/schedule", label: copy.nav.schedule },
  { href: "/nganh", label: copy.nav.nganh },
  { href: "/team", label: copy.nav.team },
  { href: "/contact", label: copy.nav.contact },
] as const;

function isCurrent(href: string): boolean {
  const localized = localePath(locale, href);
  if (href === "/") return pathname === localized;
  return pathname === localized || pathname.startsWith(`${localized}/`);
}

const pathWithoutLocale = (() => {
  if (pathname === "/vi" || pathname.startsWith("/vi/")) {
    return pathname.replace(/^\/vi/, "") || "/";
  }
  return pathname;
})();
const enPath = localePath("en", pathWithoutLocale);
const viPath = localePath("vi", pathWithoutLocale);

const htmlLang = locale === "vi" ? "vi" : "en";
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/logos/gdpt.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-sen focus:px-3 focus:py-2 focus:text-ink"
    >
      Skip to content
    </a>

    <header class="site-header">
      <div class="page-wrap flex items-center justify-between gap-4 py-3">
        <a href={localePath(locale)} class="flex items-center gap-3 min-w-0">
          <img
            src="/logos/gdpt.svg"
            alt=""
            width="40"
            height="40"
            class="shrink-0"
          />
          <span class="min-w-0">
            <span class="block font-bold text-lam-deep text-lg leading-none truncate">
              {site.nameShort}
            </span>
            <span class="block text-xs text-lam mt-1 truncate" lang="vi">
              {locale === "vi" ? site.nameEn : site.nameVi}
            </span>
          </span>
        </a>

        <nav class="hidden lg:flex items-center gap-6" aria-label="Primary">
          {
            nav.map((item) => (
              <a
                href={localePath(locale, item.href)}
                class="nav-link text-sm text-lam-deep hover:text-la"
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {t(item.label, locale)}
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-2 sm:gap-3">
          <div
            class="lang-slider"
            data-locale={locale}
            role="group"
            aria-label={locale === "vi" ? "Ngôn ngữ" : "Language"}
          >
            <span class="lang-slider-thumb" aria-hidden="true"></span>
            <a
              href={enPath}
              class="lang-slider-opt"
              hreflang="en"
              lang="en"
              aria-current={locale === "en" ? "true" : undefined}
            >
              EN
            </a>
            <a
              href={viPath}
              class="lang-slider-opt"
              hreflang="vi"
              lang="vi"
              aria-current={locale === "vi" ? "true" : undefined}
            >
              VN
            </a>
          </div>
          <a
            href={localePath(locale, "/contact")}
            class="btn btn-la header-action hidden sm:inline-flex"
          >
            {t(copy.cta.join, locale)}
          </a>

          <details class="lg:hidden relative">
            <summary class="btn btn-ghost header-action list-none cursor-pointer">
              Menu
            </summary>
            <div
              class="absolute right-0 mt-2 w-56 border border-rule bg-sen p-3 flex flex-col gap-2 shadow-sm"
            >
              {
                nav.map((item) => (
                  <a
                    href={localePath(locale, item.href)}
                    class="nav-link text-sm py-2 text-lam-deep"
                    aria-current={isCurrent(item.href) ? "page" : undefined}
                  >
                    {t(item.label, locale)}
                  </a>
                ))
              }
              <a href={localePath(locale, "/contact")} class="btn btn-la mt-1 sm:hidden">
                {t(copy.cta.join, locale)}
              </a>
            </div>
          </details>
        </div>
      </div>
    </header>

    <div id="main">
      <slot />
    </div>

    <footer class="mt-auto bg-lam-deep text-sen">
      <div class="page-wrap py-14 grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <img src="/logos/gdpt.svg" alt="" width="36" height="36" />
            <strong class="text-xl">{site.nameShort}</strong>
          </div>
          <p class="text-sm text-white/80 max-w-md m-0">
            {t(copy.footer.mission, locale)}
          </p>
        </div>
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-white/60 mb-3">
            {t(copy.nav.schedule, locale)}
          </h2>
          <p class="text-sm m-0 mb-2">{t(site.sunday, locale)}</p>
          <a class="text-sm underline underline-offset-2" href={localePath(locale, "/schedule")}>
            {t(copy.nav.schedule, locale)}
          </a>
        </div>
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-white/60 mb-3">
            {t(copy.nav.contact, locale)}
          </h2>
          <p class="text-sm m-0" lang={locale === "vi" ? "vi" : "en"}>
            {t(site.address, locale)}
          </p>
          <p class="text-sm m-0 mt-1">{site.addressLines[locale][0]}</p>
          <p class="text-sm m-0 mt-3">
            <a class="underline underline-offset-2" href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </div>
      </div>
      <div class="page-wrap border-t border-white/15 py-5 text-xs text-white/50">
        © {new Date().getFullYear()} {site.nameShort}
      </div>
    </footer>
  </body>
</html>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
