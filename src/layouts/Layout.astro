---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import {
  copy,
  localeFromPath,
  localePath,
  site,
  t,
  type Locale,
} from "../i18n/site";

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
}

const pathname = Astro.url.pathname;
const locale = Astro.props.locale ?? localeFromPath(pathname);
const {
  title,
  description =
    locale === "vi"
      ? "GĐPT Anôma là đơn vị Gia Đình Phật Tử tại Văn Hạnh Foundation ở Gardena. Các em lớn lên với Bi–Trí–Dũng qua tập hợp, Phật pháp, và giờ ngành mỗi Chủ Nhật."
      : "GĐPT Anôma is a Vietnamese Buddhist youth chapter at Văn Hạnh Foundation in Gardena. Kids grow with Bi–Trí–Dũng through Sunday formation, Phật pháp, and ngành activities.",
} = Astro.props;

const nav = [
  { href: "/about", label: copy.nav.about },
  { href: "/schedule", label: copy.nav.schedule },
  { href: "/nganh", label: copy.nav.nganh },
  { href: "/team", label: copy.nav.team },
  { href: "/contact", label: copy.nav.contact },
] as const;

function isCurrent(href: string): boolean {
  const localized = localePath(locale, href);
  if (href === "/") return pathname === localized;
  return pathname === localized || pathname.startsWith(`${localized}/`);
}

const pathWithoutLocale = (() => {
  if (pathname === "/vi" || pathname.startsWith("/vi/")) {
    return pathname.replace(/^\/vi/, "") || "/";
  }
  return pathname;
})();
const enPath = localePath("en", pathWithoutLocale);
const viPath = localePath("vi", pathWithoutLocale);

const htmlLang = locale === "vi" ? "vi" : "en";
---

<!doctype html>
<html lang={htmlLang} translate="no" class="notranslate" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google" content="notranslate" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/logos/gdpt.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-sen focus:px-3 focus:py-2 focus:text-ink"
    >
      Skip to content
    </a>

    <header class="site-header" data-site-header>
      <div class="page-wrap header-bar">
        <a href={localePath(locale)} class="header-brand flex items-center gap-2.5 sm:gap-3 min-w-0">
          <img
            src="/logos/gdpt.svg"
            alt=""
            width="40"
            height="40"
            class="header-brand-mark shrink-0"
          />
          <span class="min-w-0">
            <span class="block font-bold text-lam-deep text-base sm:text-lg leading-none truncate">
              {site.nameShort}
            </span>
            <span class="header-brand-sub block text-xs text-lam mt-0.5 sm:mt-1 truncate">
              Văn Hạnh Foundation
            </span>
          </span>
        </a>

        <nav class="header-nav hidden lg:grid" aria-label="Primary">
          {
            nav.map((item) => (
              <a
                href={localePath(locale, item.href)}
                class="nav-link text-sm text-lam-deep hover:text-la"
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {t(item.label, locale)}
              </a>
            ))
          }
        </nav>

        <div class="header-end flex items-center justify-end gap-1.5 sm:gap-3">
          <div
            class="lang-slider"
            data-locale={locale}
            role="group"
            aria-label={locale === "vi" ? "Ngôn ngữ" : "Language"}
          >
            <span class="lang-slider-thumb" aria-hidden="true"></span>
            <a
              href={enPath}
              class="lang-slider-opt"
              hreflang="en"
              lang="en"
              aria-current={locale === "en" ? "true" : undefined}
            >
              EN
            </a>
            <a
              href={viPath}
              class="lang-slider-opt"
              hreflang="vi"
              lang="vi"
              aria-current={locale === "vi" ? "true" : undefined}
            >
              VN
            </a>
          </div>
          <a
            href={localePath(locale, "/contact")}
            class="btn btn-la header-action hidden sm:inline-flex"
          >
            {t(copy.cta.join, locale)}
          </a>

          <button
            type="button"
            class="nav-toggle lg:hidden"
            aria-expanded="false"
            aria-controls="mobile-nav"
            data-nav-toggle
          >
            <span class="sr-only">{locale === "vi" ? "Điều hướng" : "Navigation"}</span>
            <span class="nav-toggle-bars" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
          </button>
        </div>
      </div>

      <div
        id="mobile-nav"
        class="mobile-drawer lg:hidden"
        data-mobile-drawer
        hidden
      >
        <nav class="mobile-drawer-nav page-wrap" aria-label="Primary">
          {
            nav.map((item) => (
              <a
                href={localePath(locale, item.href)}
                class="nav-link mobile-drawer-link text-lam-deep"
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {t(item.label, locale)}
              </a>
            ))
          }
          <a
            href={localePath(locale, "/contact")}
            class="btn btn-la mobile-drawer-cta sm:hidden"
          >
            {t(copy.cta.join, locale)}
          </a>
        </nav>
      </div>
    </header>

    <div id="main">
      <slot />
    </div>

    <footer class="mt-auto bg-lam-deep text-sen">
      <div class="page-wrap py-14 grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <img src="/logos/gdpt.svg" alt="" width="36" height="36" />
            <strong class="text-xl">{site.nameShort}</strong>
          </div>
          <p class="text-sm text-white/80 max-w-md m-0">
            {t(copy.footer.mission, locale)}
          </p>
        </div>
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-white/60 mb-3">
            {t(copy.nav.schedule, locale)}
          </h2>
          <p class="text-sm m-0 mb-2">{t(site.sunday, locale)}</p>
          <a class="text-sm underline underline-offset-2" href={localePath(locale, "/schedule")}>
            {t(copy.nav.schedule, locale)}
          </a>
        </div>
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-white/60 mb-3">
            {t(copy.nav.contact, locale)}
          </h2>
          <p class="text-sm m-0" lang={locale === "vi" ? "vi" : "en"}>
            {t(site.address, locale)}
          </p>
          <p class="text-sm m-0 mt-1">{site.addressLines[locale][0]}</p>
          <p class="text-sm m-0 mt-3">
            <a class="underline underline-offset-2" href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </div>
      </div>
      <div class="page-wrap border-t border-white/15 py-5 text-xs text-white/50">
        © {new Date().getFullYear()} {site.nameShort}
      </div>
    </footer>
    <script is:inline src="/lang-morph.js?v=11"></script>
    <script is:inline>
      (function () {
        if (window.__gdptNavInit) return;
        window.__gdptNavInit = true;

        function els() {
          return {
            header: document.querySelector("[data-site-header]"),
            toggle: document.querySelector("[data-nav-toggle]"),
            drawer: document.querySelector("[data-mobile-drawer]"),
          };
        }

        function syncHeaderOffset(header) {
          if (!(header instanceof HTMLElement)) return;
          document.documentElement.style.setProperty(
            "--header-offset",
            header.offsetHeight + "px",
          );
        }

        function setOpen(open) {
          const { header, toggle, drawer } = els();
          if (!(header instanceof HTMLElement) || !(toggle instanceof HTMLElement) || !(drawer instanceof HTMLElement)) {
            return;
          }

          syncHeaderOffset(header);

          if (open) {
            header.setAttribute("data-nav-open", "");
            drawer.hidden = false;
            void drawer.offsetWidth;
            drawer.classList.add("is-open");
            toggle.setAttribute("aria-expanded", "true");
            document.body.classList.add("nav-locked");
          } else {
            header.removeAttribute("data-nav-open");
            drawer.classList.remove("is-open");
            toggle.setAttribute("aria-expanded", "false");
            document.body.classList.remove("nav-locked");
            const reduce =
              window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            if (reduce) {
              drawer.hidden = true;
            } else {
              window.setTimeout(function () {
                if (!header.hasAttribute("data-nav-open")) drawer.hidden = true;
              }, 400);
            }
          }
        }

        function onPageLoad() {
          const { header } = els();
          syncHeaderOffset(header);
          setOpen(false);
        }

        document.addEventListener("click", function (e) {
          const target = e.target instanceof Element ? e.target : null;
          if (!target) return;

          if (target.closest("[data-nav-toggle]")) {
            const { header } = els();
            setOpen(!(header instanceof HTMLElement && header.hasAttribute("data-nav-open")));
            return;
          }

          if (target.closest("[data-mobile-drawer] a")) {
            setOpen(false);
          }
        });

        document.addEventListener("transitionend", function (e) {
          const drawer = e.target;
          if (!(drawer instanceof HTMLElement) || !drawer.hasAttribute("data-mobile-drawer")) return;
          if (e.propertyName !== "transform") return;
          const { header } = els();
          if (!(header instanceof HTMLElement) || header.hasAttribute("data-nav-open")) return;
          drawer.hidden = true;
        });

        document.addEventListener("keydown", function (e) {
          if (e.key !== "Escape") return;
          const { header, toggle } = els();
          if (!(header instanceof HTMLElement) || !header.hasAttribute("data-nav-open")) return;
          setOpen(false);
          if (toggle instanceof HTMLElement) toggle.focus();
        });

        window.addEventListener("resize", function () {
          const { header } = els();
          syncHeaderOffset(header);
          if (window.matchMedia("(min-width: 1024px)").matches) setOpen(false);
        });

        onPageLoad();
        document.addEventListener("astro:page-load", onPageLoad);
      })();
    </script>
  </body>
</html>
